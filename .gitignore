# ==============================================================================
# WILDSCOPE AI — Git Ignore Rules
# ==============================================================================

# OS & Environment Files
desktop.ini
Thumbs.db
.DS_Store

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments & Packages
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database & Persistent Storage (SQLite local files)
*.db
*.sqlite
*.sqlite3
wildscope.db*
storage/media/
storage/uploads/
storage/temp/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Local Environment Variables & Secrets
.env
.env.local
.env.*.local
*.log

# Large Datasets & Archives
data/
*.zip
caltech_camera_traps*
*.tar.gz
*.tar

# IDE & Editor Scratch Directories
.vscode/
.idea/
*.swp
*.swo
*~
