{
  "$defs": {
    "CalibrationStatus": {
      "description": "Status of model probability calibration.",
      "enum": [
        "uncalibrated",
        "calibrated",
        "not_applicable"
      ],
      "title": "CalibrationStatus",
      "type": "string"
    },
    "Camera": {
      "additionalProperties": false,
      "description": "Physical camera trap device record.\nSupports location-based grouping via site_id even when geographical\ncoordinates are unknown or withheld.",
      "properties": {
        "id": {
          "description": "Stable unique identifier for the camera.",
          "title": "Id",
          "type": "string"
        },
        "site_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional site or station identifier for hierarchical grouping.",
          "title": "Site Id"
        },
        "latitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WGS84 latitude in decimal degrees [-90, 90].",
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WGS84 longitude in decimal degrees [-180, 180].",
          "title": "Longitude"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declared IANA timezone identifier, e.g. 'Asia/Kolkata'.",
          "title": "Timezone"
        },
        "provenance": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Origin tracking for supplied camera metadata.",
          "title": "Provenance"
        }
      },
      "required": [
        "id"
      ],
      "title": "Camera",
      "type": "object"
    },
    "Detection": {
      "additionalProperties": false,
      "description": "Object-level animal detection and classification output.\nDistinguishes detection confidence from classification confidence,\nand explicitly tracks triage status and uncertainty.",
      "properties": {
        "id": {
          "description": "Stable unique detection ID.",
          "title": "Id",
          "type": "string"
        },
        "observation_id": {
          "description": "Reference to parent Observation record.",
          "title": "Observation Id",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to PredictionRun that generated this output.",
          "title": "Run Id"
        },
        "triage_state": {
          "$ref": "#/$defs/TriageState",
          "default": "animal_detected",
          "description": "Triage outcome (likely_empty, animal_detected, processing_failure, unsupported_taxon)."
        },
        "animal_detection_confidence": {
          "description": "Confidence that an animal is present in the frame/crop [0.0, 1.0].",
          "title": "Animal Detection Confidence",
          "type": "number"
        },
        "predicted_taxon_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Canonical taxon identifier if species classification succeeded.",
          "title": "Predicted Taxon Id"
        },
        "raw_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original unmodified label emitted by the vision classifier.",
          "title": "Raw Label"
        },
        "classification_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Species classification score in [0.0, 1.0].",
          "title": "Classification Confidence"
        },
        "score_type": {
          "$ref": "#/$defs/ScoreType",
          "default": "softmax",
          "description": "Output type of the classification score."
        },
        "calibration_status": {
          "$ref": "#/$defs/CalibrationStatus",
          "default": "uncalibrated",
          "description": "Probability calibration status."
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedBBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized bounding box of detection in frame."
        },
        "alternatives": {
          "description": "Documented alternative species hypotheses.",
          "items": {
            "$ref": "#/$defs/TaxonAlternative"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "id",
        "observation_id",
        "animal_detection_confidence"
      ],
      "title": "Detection",
      "type": "object"
    },
    "Encounter": {
      "additionalProperties": false,
      "description": "Operational grouping of observations within a camera trap temporal session.\nRepresents an encounter event; does NOT establish individual animal identity\nor population size.",
      "properties": {
        "id": {
          "description": "Stable unique encounter identifier.",
          "title": "Id",
          "type": "string"
        },
        "camera_id": {
          "description": "Reference to Camera where encounter occurred.",
          "title": "Camera Id",
          "type": "string"
        },
        "member_observation_ids": {
          "description": "Observation IDs included in this encounter.",
          "items": {
            "type": "string"
          },
          "title": "Member Observation Ids",
          "type": "array"
        },
        "member_detection_ids": {
          "description": "Detection IDs included in this encounter.",
          "items": {
            "type": "string"
          },
          "title": "Member Detection Ids",
          "type": "array"
        },
        "start_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Encounter start timestamp (timezone-aware).",
          "title": "Start Time"
        },
        "end_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Encounter end timestamp (timezone-aware).",
          "title": "End Time"
        },
        "rule_version": {
          "default": "v1_time_gap",
          "description": "Grouping algorithm version (e.g. 30-minute burst gap).",
          "title": "Rule Version",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evidence trace and grouping metadata.",
          "title": "Provenance"
        }
      },
      "required": [
        "id",
        "camera_id"
      ],
      "title": "Encounter",
      "type": "object"
    },
    "MediaAsset": {
      "additionalProperties": false,
      "description": "Source raw media file (image or video) stored in object/file storage.",
      "properties": {
        "id": {
          "description": "Stable unique identifier for media asset.",
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "$ref": "#/$defs/MediaType",
          "default": "image",
          "description": "image or video."
        },
        "camera_id": {
          "description": "Reference to Camera where recorded.",
          "title": "Camera Id",
          "type": "string"
        },
        "storage_key": {
          "description": "Internal storage identifier or path key.",
          "title": "Storage Key",
          "type": "string"
        },
        "raw_timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unparsed raw timestamp string from EXIF or filename.",
          "title": "Raw Timestamp"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Resolved timezone-aware capture timestamp.",
          "title": "Captured At"
        },
        "timezone_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How timezone was resolved (e.g. 'camera_profile', 'exif_offset').",
          "title": "Timezone Source"
        },
        "provenance": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source provenance details.",
          "title": "Provenance"
        }
      },
      "required": [
        "id",
        "camera_id",
        "storage_key"
      ],
      "title": "MediaAsset",
      "type": "object"
    },
    "MediaType": {
      "description": "Type of ingested camera-trap media.",
      "enum": [
        "image",
        "video"
      ],
      "title": "MediaType",
      "type": "string"
    },
    "MonitoringEffort": {
      "additionalProperties": false,
      "description": "Explicit documented operational effort intervals for a camera.\nUptime is NOT inferred from image frequency or span.",
      "properties": {
        "id": {
          "description": "Stable unique monitoring effort record ID.",
          "title": "Id",
          "type": "string"
        },
        "camera_id": {
          "description": "Reference to Camera.",
          "title": "Camera Id",
          "type": "string"
        },
        "active_intervals": {
          "description": "Disjoint, non-overlapping active monitoring periods.",
          "items": {
            "$ref": "#/$defs/TimeInterval"
          },
          "title": "Active Intervals",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source of effort record (e.g. 'ranger_log', 'telemetry_heartbeat').",
          "title": "Source"
        },
        "completeness_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Known limitations or gaps in effort tracking.",
          "title": "Completeness Notes"
        }
      },
      "required": [
        "id",
        "camera_id"
      ],
      "title": "MonitoringEffort",
      "type": "object"
    },
    "NormalizedBBox": {
      "additionalProperties": false,
      "description": "Normalized bounding box.\nConvention: Coordinates in [0.0, 1.0] relative to frame dimensions.\n(0, 0) is top-left, (1, 1) is bottom-right.",
      "properties": {
        "x_min": {
          "description": "Left edge normalized coordinate [0, 1].",
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "description": "Top edge normalized coordinate [0, 1].",
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "description": "Right edge normalized coordinate [0, 1].",
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "description": "Bottom edge normalized coordinate [0, 1].",
          "title": "Y Max",
          "type": "number"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "title": "NormalizedBBox",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "An individual frame or standalone image observation event.\nLinks detections to source media and physical camera.",
      "properties": {
        "id": {
          "description": "Stable unique observation identifier.",
          "title": "Id",
          "type": "string"
        },
        "camera_id": {
          "description": "Reference to physical Camera.",
          "title": "Camera Id",
          "type": "string"
        },
        "source_media_id": {
          "description": "Reference to MediaAsset.",
          "title": "Source Media Id",
          "type": "string"
        },
        "frame_offset_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Video frame offset in milliseconds (null for still photos).",
          "title": "Frame Offset Ms"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Resolved timezone-aware capture timestamp.",
          "title": "Captured At"
        },
        "raw_timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw EXIF timestamp string preserved for audit.",
          "title": "Raw Timestamp"
        },
        "timezone_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Method used to establish timezone.",
          "title": "Timezone Source"
        },
        "width_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source image width in pixels.",
          "title": "Width Px"
        },
        "height_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source image height in pixels.",
          "title": "Height Px"
        },
        "detection_ids": {
          "description": "Ordered list of Detection IDs belonging to this observation.",
          "items": {
            "type": "string"
          },
          "title": "Detection Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "camera_id",
        "source_media_id"
      ],
      "title": "Observation",
      "type": "object"
    },
    "PredictionRun": {
      "additionalProperties": false,
      "description": "Audit record of an inference model run.\nEnsures complete traceability of model hashes, device, and settings.",
      "properties": {
        "id": {
          "description": "Stable unique prediction run identifier.",
          "title": "Id",
          "type": "string"
        },
        "model_version": {
          "description": "Version identifier of vision model artifact.",
          "title": "Model Version",
          "type": "string"
        },
        "settings_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hash of inference hyper-parameters.",
          "title": "Settings Hash"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Execution device (e.g. 'cuda:0', 'cpu').",
          "title": "Device"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Job execution start time.",
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Job completion time.",
          "title": "Completed At"
        },
        "status": {
          "$ref": "#/$defs/PredictionStatus",
          "default": "completed",
          "description": "Job completion status."
        },
        "cache_hit": {
          "default": false,
          "description": "Whether output was served from cache.",
          "title": "Cache Hit",
          "type": "boolean"
        },
        "failure_codes": {
          "description": "Non-fatal failure codes.",
          "items": {
            "type": "string"
          },
          "title": "Failure Codes",
          "type": "array"
        },
        "input_content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hash of input media payload.",
          "title": "Input Content Hash"
        },
        "model_artifact_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hash of weights artifact.",
          "title": "Model Artifact Hash"
        },
        "preprocessing_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hash of transform pipeline.",
          "title": "Preprocessing Hash"
        }
      },
      "required": [
        "id",
        "model_version"
      ],
      "title": "PredictionRun",
      "type": "object"
    },
    "PredictionStatus": {
      "description": "Status of an inference execution run.",
      "enum": [
        "completed",
        "failed",
        "partial"
      ],
      "title": "PredictionStatus",
      "type": "string"
    },
    "ReviewDecision": {
      "description": "Human review decision on a target detection or encounter.\nReviews are append-only audit events and do not mutate original model outputs.",
      "enum": [
        "confirm_species",
        "correct_species",
        "mark_unknown",
        "reject_detection",
        "flag_for_expert"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ReviewEvent": {
      "additionalProperties": false,
      "description": "Human review decision.\nOriginal model outputs remain immutable; reviews are append-only audit events.\nThe effective state is resolved transactionally by the backend.",
      "properties": {
        "id": {
          "description": "Stable unique review event ID.",
          "title": "Id",
          "type": "string"
        },
        "target_id": {
          "description": "Reference to target Detection ID (or Encounter ID).",
          "title": "Target Id",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ReviewDecision",
          "description": "Review outcome decision."
        },
        "corrected_taxon_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required if decision is CORRECT_SPECIES, forbidden if REJECT_DETECTION.",
          "title": "Corrected Taxon Id"
        },
        "reviewer": {
          "description": "Reviewer identifier or username.",
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional reasoning or notes.",
          "title": "Reason"
        },
        "created_at": {
          "description": "Timestamp when review was executed.",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source dataset revision at time of review (for optimistic concurrency).",
          "title": "Expected Revision"
        }
      },
      "required": [
        "id",
        "target_id",
        "decision",
        "reviewer",
        "created_at"
      ],
      "title": "ReviewEvent",
      "type": "object"
    },
    "ScoreType": {
      "description": "Semantic nature of model prediction score.\nCrucial for preventing mistaking raw logits or uncalibrated softmax scores\nfor true posterior probabilities.",
      "enum": [
        "raw",
        "softmax",
        "calibrated",
        "probability"
      ],
      "title": "ScoreType",
      "type": "string"
    },
    "SnapshotMetadata": {
      "additionalProperties": false,
      "description": "Metadata describing snapshot provenance, structural schema version,\nand underlying transactional data revision.",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "description": "Semantic version of the data contract schema.",
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_revision": {
          "description": "Transactional data revision counter identifying this data state.",
          "minimum": 0,
          "title": "Dataset Revision",
          "type": "integer"
        },
        "created_at": {
          "description": "Timezone-aware timestamp when snapshot was assembled.",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "source_system": {
          "default": "WILDSCOPE_BACKEND",
          "description": "System or worker generating this snapshot.",
          "title": "Source System",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Traceability metadata for snapshot assembly.",
          "title": "Provenance"
        },
        "has_spatial_context": {
          "default": false,
          "description": "Flag indicating whether spatial zones and layers are included.",
          "title": "Has Spatial Context",
          "type": "boolean"
        },
        "has_monitoring_effort": {
          "default": false,
          "description": "Flag indicating whether verified camera active intervals are supplied.",
          "title": "Has Monitoring Effort",
          "type": "boolean"
        }
      },
      "required": [
        "dataset_revision",
        "created_at"
      ],
      "title": "SnapshotMetadata",
      "type": "object"
    },
    "SpatialContext": {
      "additionalProperties": false,
      "description": "Optional spatial context provided with a snapshot.\nCamera coordinates are not exact animal coordinates.",
      "properties": {
        "crs": {
          "default": "EPSG:4326",
          "description": "Coordinate Reference System.",
          "title": "Crs",
          "type": "string"
        },
        "zones": {
          "description": "Defined reserve boundaries or management zones.",
          "items": {
            "$ref": "#/$defs/SpatialZone"
          },
          "title": "Zones",
          "type": "array"
        },
        "candidate_sites": {
          "description": "Potential deployment sites for adaptive coverage optimization.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Candidate Sites",
          "type": "array"
        },
        "coverage_assumptions": {
          "additionalProperties": true,
          "description": "Documented sensor range or viewshed assumptions.",
          "title": "Coverage Assumptions",
          "type": "object"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source of GIS layers and spatial metadata.",
          "title": "Provenance"
        }
      },
      "title": "SpatialContext",
      "type": "object"
    },
    "SpatialZone": {
      "additionalProperties": false,
      "description": "Supplied spatial zone boundary (e.g. park core, corridor, buffer zone).",
      "properties": {
        "id": {
          "description": "Stable zone identifier.",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Human-readable zone label.",
          "title": "Name",
